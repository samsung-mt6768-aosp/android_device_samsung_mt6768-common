type sysfs_battery, fs_type, sysfs_type;

# dma-buf internal pseudo-fs (drivers/dma-buf/dma-buf.c: mount_pseudo "dmabuf:"),
# unlabeled until now -> statfs from RenderThreads was audited 100s of times per
# minute while rendering. Label it and allow the harmless getattr (statfs).
type dmabuf_fs, fs_type;
