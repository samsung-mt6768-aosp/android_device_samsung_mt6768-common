# Ergaenzung zur device/lineage-Deklaration: die HAL liest/schreibt die
# TSP-Sysfs-Knoten (cmd, cmd_list, cmd_result -> sysfs_sec, Prefix-Matching).
# Belegt: AVC-Log Phase 1 + isSupported()-Aufrufe in hardware/samsung/aidl/touch.
allow hal_lineage_touch_default sysfs_sec:dir r_dir_perms;
allow hal_lineage_touch_default sysfs_sec:file rw_file_perms;
