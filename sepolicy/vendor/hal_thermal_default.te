allow hal_thermal_default sysfs_ss_writable:file r_file_perms;
allow hal_thermal_default sysfs_battery:dir r_dir_perms;
allow hal_thermal_default sysfs_battery:file r_file_perms;
allow hal_thermal_default sysfs_battery:lnk_file r_file_perms;
allow hal_thermal_default sysfs_power:file r_file_perms;

allow hal_thermal_default hal_thermal_hwservice:hwservice_manager { add find };

set_prop(hal_thermal_default, vendor_thermal_test_prop)
get_prop(hal_thermal_default, vendor_thermal_prop)

# sec-ap-thermistor/temperature (Phase-1-AVC: 82x)
allow hal_thermal_default sysfs_sec:dir r_dir_perms;
allow hal_thermal_default sysfs_sec:file r_file_perms;
